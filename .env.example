# Configuration template. Two ways to supply real credentials:
#
#   PREFERRED: keep keys in ONE private file outside every repo, e.g.
#   ~/.secrets/ai.env (chmod 600), and point ENV_FILE at it per run:
#       ENV_FILE=~/.secrets/ai.env AGENT_PROVIDER=anthropic python scripts/run_demo.py
#       ENV_FILE=~/.secrets/ai.env AGENT_PROVIDER=openai    python scripts/run_demo.py
#   Keys never appear in commands, shell history, or the repo.
#
#   ALTERNATIVE: cp .env.example .env and fill it in. NEVER commit .env.
#
# With no provider configured the system runs the deterministic offline mock.

# mock | anthropic | openai
AGENT_PROVIDER=mock

# Required only for the matching provider:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# AGENT_MODEL=                      # universal override, wins for either provider
# MAX_OUTPUT_TOKENS=1500           # cap on the model's reply; a truncated
#                                  # reply abstains as model_output_unparseable

# --- Retrieval -------------------------------------------------------------
# CORPUS_DIR=corpus
# TOP_K=4
# RETRIEVAL_SATURATION=8.0
# MIN_RETRIEVAL_CONFIDENCE=0.35

# --- Verification ----------------------------------------------------------
# MIN_CLAIM_COVERAGE=0.6
# REQUIRE_NUMERIC_GROUNDING=true

# --- Abstention ------------------------------------------------------------
# MIN_SUPPORTED_RATIO=0.6
# MIN_ANSWER_RELEVANCE=0.4

# --- Audit and eval gate ---------------------------------------------------
# AUDIT_LOG_PATH=audit/audit.log.jsonl
# Unset by default. Unkeyed, the chain detects an in-place edit but NOT an
# editor who recomputes the whole chain; set a key and re-chaining needs it.
# Keep it out of the repository: use the environment or ENV_FILE.
# AUDIT_HMAC_KEY=
# EVAL_MIN_CITATION_PRECISION=1.0   # over SERVED citations: an invariant
# EVAL_MAX_UNSUPPORTED_SERVED=0
# EVAL_MIN_ABSTENTION_RECALL=1.0
# EVAL_MAX_FALSE_ABSTENTION_RATE=0.2
